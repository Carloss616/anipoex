+/**
+ A matching `Host` is resized by Yoga a commit after its content changes size, and for that frame
+ `UIHostingController` centres the larger or smaller content in the old bounds — shifting the whole
+ page. Pinning the content to the host's leading edge keeps it where it was until the resize lands.
+ Placed outside `GeometryChangeModifier`, so the size reported to Yoga is still the content's.
+ */
+private struct PinToHostOriginModifier: ViewModifier {
+  let isEnabled: Bool
+  let alignment: Alignment
+
+  func body(content: Content) -> some View {
+    if isEnabled {
+      // The explicit zero minimums make the frame take the proposed (old) size even when the
+      // content has already outgrown it; without them it grows to the content and gets centred.
+      content.frame(minWidth: 0, maxWidth: .infinity, minHeight: 0, maxHeight: .infinity, alignment: alignment)
+    } else {
+      content
+    }
+  }
+}
