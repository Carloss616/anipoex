{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.agents",
      "!**/.claude",
      "!**/.git",
      "!**/.github",
      "!**/node_modules",
      "!**/uniwind-types.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineEnding": "auto"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useValidAriaRole": {
          "level": "error",
          "options": {
            "ignoreNonDom": true
          }
        }
      },
      "correctness": {
        "noReactNativeRawText": {
          "level": "error",
          "options": {
            "skip": [
              "Alert.Title",
              "Badge",
              "Button",
              "Frame.Action",
              "Frame.Description",
              "Frame.Title",
              "Label",
              "Muted",
              "NativeButton",
              "NativeTabs.Trigger.Label",
              "Sheet.Close",
              "Sheet.Description",
              "Sheet.Title",
              "Stack.Title",
              "Stat.Unit",
              "Typography",
              "Typography.Code",
              "WebButton"
            ]
          }
        }
      },
      "nursery": {
        "useTailwindSortedClasses": "warn"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@expo/ui/community/bottom-sheet": "Import from @/components/ui/bottom-sheet",
              "@legendapp/list": "Import from @/components/layout/legend-list",
              "@legendapp/list/react": "Import from @/components/layout/legend-list",
              "@legendapp/list/react-native": "Import from @/components/layout/legend-list",
              "panelui-native": "Import scoped: panelui-native/components/<component>, /provider, /theme or /primitives/<primitive>",
              "panelui-native/components/bottom-sheet": "Import from @/components/ui/bottom-sheet",
              "panelui-native/components/button-group": "On web, import from panelui-web/button-group",
              "panelui-native/components/chip": "Import from @/components/ui/chip",
              "panelui-native/components/loader": "Import from @/components/ui/loader",
              "panelui-native/components/progress": "Import from @/components/ui/progress",
              "panelui-native/components/rating": "Import from @/components/ui/rating",
              "panelui-native/components/spinner": "Import from @/components/ui/loader",
              "panelui-native/components/toast": "Import from @/components/ui/toast",
              "panelui-native/primitives/animated-pressable": "Use react-native's Pressable with PRESS from @/components/ui/press",
              "sonner": "Import from @/components/ui/toast"
            },
            "patterns": [
              {
                "group": ["@expo/ui"],
                "importNamePattern": "BottomSheet",
                "message": "Use BottomSheet from @/components/ui/bottom-sheet"
              },
              {
                "group": ["@expo/ui"],
                "importNamePattern": "Host|RNHostView",
                "message": "Use Host or RNHostView from @/components/ui/host"
              },
              {
                "group": ["@expo/ui"],
                "importNamePattern": "Icon",
                "message": "Use Icon from @/components/ui/icon"
              },
              {
                "group": ["@expo/ui/swift-ui"],
                "importNamePattern": "Alert|ConfirmationDialog",
                "message": "Use Dialog from @/components/ui/dialog"
              },
              {
                "group": ["@expo/ui/jetpack-compose"],
                "importNamePattern": "AlertDialog|BasicAlertDialog",
                "message": "Use Dialog from @/components/ui/dialog"
              },
              {
                "group": ["react-native"],
                "importNamePattern": "ActivityIndicator",
                "message": "Use Loader from @/components/ui/loader"
              },
              {
                "group": ["react-native"],
                "importNamePattern": "TouchableNativeFeedback",
                "message": "Use TouchableNativeFeedback from @/components/ui/touchable-native-feedback"
              },
              {
                "group": ["@expo/ui/swift-ui"],
                "importNamePattern": "Menu",
                "message": "Use Menu from @/components/ui/menu"
              },
              {
                "group": ["@expo/ui/jetpack-compose"],
                "importNamePattern": "DropdownMenu(Item)?",
                "message": "Use Menu from @/components/ui/menu"
              },
              {
                "group": ["@expo/ui/swift-ui"],
                "importNamePattern": "Text",
                "message": "Use Text from @/components/native/swift-ui/text"
              },
              {
                "group": ["@expo/ui/jetpack-compose"],
                "importNamePattern": "Text",
                "message": "Use Text from @/components/native/jetpack-compose/text"
              },
              {
                "group": ["@expo/ui/swift-ui"],
                "importNamePattern": "Image",
                "message": "Use Icon from @/components/ui/icon for symbols, Image from @/components/native/swift-ui/image for URLs"
              },
              {
                "group": ["@expo/ui/swift-ui"],
                "importNamePattern": "BottomSheet",
                "message": "Use BottomSheet from @/components/ui/bottom-sheet"
              },
              {
                "group": ["@expo/ui/jetpack-compose"],
                "importNamePattern": "ModalBottomSheet",
                "message": "Use BottomSheet from @/components/ui/bottom-sheet"
              },
              {
                "group": ["@expo/ui/swift-ui"],
                "importNamePattern": "ProgressView",
                "message": "Use Loader from @/components/ui/loader or Progress from @/components/ui/progress"
              },
              {
                "group": ["@expo/ui/jetpack-compose"],
                "importNamePattern": "((Circular|Linear)(Wavy)?ProgressIndicator|(Contained)?LoadingIndicator)",
                "message": "Use Loader from @/components/ui/loader or Progress from @/components/ui/progress"
              },
              {
                "group": ["@expo/ui/swift-ui", "@expo/ui/jetpack-compose"],
                "importNamePattern": "Slider",
                "message": "Use Slider from @/components/ui/slider"
              },
              {
                "group": ["@expo/ui/swift-ui", "@expo/ui/jetpack-compose"],
                "importNamePattern": "(DatePicker|DateTimePicker)",
                "message": "Use Calendar from @/components/ui/calendar"
              },
              {
                "group": ["@expo/ui/jetpack-compose"],
                "importNamePattern": "SnackbarHost",
                "message": "Use Toast from @/components/ui/toast"
              },
              {
                "group": ["@expo/ui/jetpack-compose"],
                "importNamePattern": "Badge",
                "message": "Use Badge from @/components/ui/badge"
              },
              {
                "group": ["@expo/ui/jetpack-compose"],
                "importNamePattern": "Image",
                "message": "Use Image from @/components/native/jetpack-compose/image: @expo/ui's decodes at full size and an oversized image crashes the app"
              },
              {
                "group": ["@expo/ui/swift-ui", "@expo/ui/jetpack-compose"],
                "importNamePattern": "AnimatedVisibility",
                "message": "Use AnimatedVisibility from @/components/ui/animated-visibility"
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/components/ui/**",
        "src/components/layout/**",
        "src/components/native/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "panelui-native": "Import scoped: panelui-native/components/<component>, /provider, /theme or /primitives/<primitive>"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/manga/utils/scan-activity/**"],
      "linter": {
        "rules": { "style": { "noRestrictedImports": "off" } }
      }
    },
    {
      "includes": ["src/**/*.generated.{ts,tsx}"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
